# Copy to .env and fill in. .env is gitignored and must never be committed.
# The key belongs to a dedicated, least-privilege service user with Inventory
# rights only -- never a personal login, never an account password.
# Odoo > My Profile > Account Security > New API Key

ODOO_URL=https://your-database.odoo.com
ODOO_DB=your-database
ODOO_USER=svc_inventory_sync@example.com
ODOO_API_KEY=paste-the-api-key-here
